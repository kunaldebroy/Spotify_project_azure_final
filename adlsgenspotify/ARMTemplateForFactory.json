{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adlsgenspotify"
		},
		"Datafactory_to_Storage_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'Datafactory_to_Storage'"
		},
		"SQL_to_DataFactory_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'SQL_to_DataFactory'"
		},
		"Datafactory_to_Storage_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://spotifydatabase1.dfs.core.windows.net/"
		},
		"SQL_to_DataFactory_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "spotifyuk.database.windows.net"
		},
		"SQL_to_DataFactory_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "spotify_prem"
		},
		"SQL_to_DataFactory_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "AdminKunal"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/Datafactory_to_Storage')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('Datafactory_to_Storage_properties_typeProperties_url')]",
					"accountKey": {
						"type": "SecureString",
						"value": "[parameters('Datafactory_to_Storage_accountKey')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/SQL_to_DataFactory')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('SQL_to_DataFactory_properties_typeProperties_server')]",
					"database": "[parameters('SQL_to_DataFactory_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('SQL_to_DataFactory_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('SQL_to_DataFactory_password')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}